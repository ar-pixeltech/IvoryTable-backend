generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

enum BusinessType {
  RESTAURANT
  RETAILER
  FURNITURE
  SALON
  SANITARY
  OTHER
}

model Vendor {
  id             String   @id @default(uuid())
  name           String
  phone          String   @unique
  email          String?  @unique
  password       String
  isActive       Boolean  @default(true)
  businessType   BusinessType?
  
  subscriptionId String?
  subscription   SubscriptionPlan? @relation(fields: [subscriptionId], references: [id])

  subscriptionEndsAt DateTime?
  trialEndsAt    DateTime?

  // MENU
  categories Category[]
  products   Product[]

  // ORDERS
  orders     Order[]

  // INVENTORY
  ingredients Ingredient[]
  recipes     Recipe[]
  stockMovements StockMovement[]
  purchases   Purchase[]

  storeSettings StoreSettings?
  table Table[]

  createdAt      DateTime @default(now())
}

model SubscriptionPlan {
  id          String   @id @default(uuid())
  name        String
  price       Float
  durationDays Int
  isTrial     Boolean  @default(false)
  createdAt   DateTime @default(now())

  vendors     Vendor[]
}

model Category {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  position  Int      @default(0)

  parentId  String?  // optional for root categories
  parent    Category? @relation("CategoryToParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToParent")
  
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])

  products  Product[]

  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  costPrice   Float?
  taxRate     Float?
  image       String?
  icon        String?
  isActive    Boolean   @default(true)
  stock       Int       @default(0)

  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])

  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  orderItems  OrderItem[]
  recipe      Recipe?
  productVariant   ProductVariant[]

  createdAt   DateTime @default(now())
}

model ProductVariant {
  id        String   @id @default(uuid())
  name      String
  price     Float
  sku       String?
  barcode   String?
  isActive  Boolean  @default(true)
  color     String?
  size      String?

  productId String
  product   Product  @relation(fields: [productId], references: [id])
  
  createdAt DateTime @default(now())
}

model Table {
  id        String   @id @default(uuid())
  name      String   // e.g., "T1", "T2", "VIP-1"
  isActive  Boolean  @default(true)

  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  
  orders    Order[]
  
  createdAt DateTime @default(now())
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DILIVERY
  RETAIL
}

enum OrderStatus {
  DRAFT
  PLACED
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  UPI
  CARD
}

enum OrderItemStatus {
  PLACED
  IN_PROGRESS
  SERVED
  CANCELLED
  REFUNDED
}

model Order {
  id            String   @id @default(uuid())
  orderNumber   Int
  orderType     OrderType      @default(DINE_IN)
  status        OrderStatus    @default(DRAFT)
  paymentStatus PaymentStatus  @default(PENDING)
  paymentMethod PaymentMethod  @default(CASH)

  subTotal         Float
  taxAmount        Float
  discountAmount   Float
  totalAmount      Float
  tipAmount        Float

  tableId   String?
  table     Table?   @relation(fields: [tableId], references: [id])
  
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id])

  items         OrderItem[]

  isRefunded    Boolean   @default(false)
  refundAmount  Float?
  refundReason  String?
  refundedAt    DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  closeAt       DateTime
}

model OrderItem {
  id         String   @id @default(uuid())
  quantity   Int
  unitPrice  Float    // price at time of sale
  subtotal   Float

  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  status OrderItemStatus @default(PLACED)

  isRefunded    Boolean   @default(false)
  refundAmount  Float?
  refundReason  String?
  refundedAt    DateTime?

  createdAt  DateTime @default(now())
}

// INVENTORY
model Ingredient {
  id            String   @id @default(uuid())
  name          String
  unit          String   // kg, gram, litre, piece
  currentStock  Float
  lowStockLevel Float
  isActive      Boolean  @default(true)

  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id])

  recipeItems   RecipeIngredient[]
  items       PurchaseItem[]
  stockMovements StockMovement[]

  createdAt     DateTime @default(now())
}

model Recipe {
  id          String   @id @default(uuid())

  productId  String   @unique
  product    Product @relation(fields: [productId], references: [id])

  ingredients RecipeIngredient[]

  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])

  createdAt   DateTime @default(now())
}

model RecipeIngredient {
  id            String   @id @default(uuid())
  quantityUsed  Float

  recipeId      String
  recipe        Recipe   @relation(fields: [recipeId], references: [id])

  ingredientId  String
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id])

  createdAt     DateTime @default(now())
}

model StockMovement {
  id            String   @id @default(uuid())
  type          String   // SALE, PURCHASE, MANUAL_ADJUSTMENT
  quantity      Float
  note          String?

  ingredientId  String
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id])

  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id])

  createdAt     DateTime @default(now())
}

model Purchase {
  id          String   @id @default(uuid())
  totalCost   Float

  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])

  items       PurchaseItem[]

  createdAt   DateTime @default(now())
}

model PurchaseItem {
  id            String   @id @default(uuid())
  quantity      Float
  cost          Float

  purchaseId    String
  purchase      Purchase @relation(fields: [purchaseId], references: [id])

  ingredientId  String
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id])

  createdAt     DateTime @default(now())
}

model StoreSettings {
  id              String  @id @default(uuid())
  storeName       String
  logoURL         String? 
  gstNumber       String?
  fssaiNumber     String?
  gstPercentage   Float
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  pincode         String?
  currency        String? @default("INR")
  timezone        String? @default("Asia/Kolkata")
  invoicePrefix   String  @default("INV")
  invoiceFooter   String?

  vendorId        String   @unique
  vendor          Vendor   @relation(fields: [vendorId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
